# Unity YAML: let git treat as text, normalise line endings
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.cs        text eol=lf diff=csharp
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.asmdef    text eol=lf

# Large binaries -> Git LFS
*.blend     filter=lfs diff=lfs merge=lfs -text
*.psd       filter=lfs diff=lfs merge=lfs -text
*.wav       filter=lfs diff=lfs merge=lfs -text
*.ogg       filter=lfs diff=lfs merge=lfs -text
*.mp3       filter=lfs diff=lfs merge=lfs -text

# Small binaries kept in plain git (procedural, tiny)
*.fbx       binary
*.png       binary
*.exr       binary
